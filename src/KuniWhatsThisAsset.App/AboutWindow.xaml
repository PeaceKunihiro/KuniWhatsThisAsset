<Window x:Class="KuniWhatsThisAsset.App.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="バージョン情報" Width="500" Height="720" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F1DDC5" Foreground="#38291E" Icon="Assets/KWTA_icon.png">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" HorizontalAlignment="Center">
  <Image Source="Assets/KWTA_icon.png" Width="220" Height="230" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
  <TextBlock Text="KuniWhatsThisAsset" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,5"/>
  <TextBlock x:Name="CurrentVersion" FontSize="16" HorizontalAlignment="Center" Foreground="#70533D"/>
  <Button x:Name="CheckUpdateButton" Content="更新を確認する" Click="CheckNow_Click" Margin="0,16,0,0"/>
  <StackPanel x:Name="UpdatePanel" Visibility="Collapsed" Margin="0,16,0,0">
   <TextBlock x:Name="UpdateMessage" TextWrapping="Wrap" HorizontalAlignment="Center" FontWeight="SemiBold"/>
   <TextBlock Text="ダウンロード・検証後にアプリを終了して再起動します。ユーザー設定は保持します。" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <Button x:Name="DownloadUpdateButton" Content="ダウンロードして更新・再起動" Click="Download_Click" Margin="0,8,0,0"/>
  </StackPanel>
  <ProgressBar x:Name="UpdateProgressBar" Height="8" Margin="0,12,0,0" Visibility="Collapsed"/>
  <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="410"/>
  <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0"><Hyperlink x:Name="StableLink" Click="Stable_Click">GitHubのStableを開く</Hyperlink></TextBlock>
  <Button Content="閉じる" IsCancel="True" Width="100" Margin="0,20,0,0"/>
 </StackPanel></ScrollViewer>
</Window>

