<Window x:Class="KuniWhatsThisAsset.App.RepackageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="フォルダーにまとめて保存" Width="680" Height="650" MinWidth="580" MinHeight="550" WindowStartupLocation="CenterOwner" Background="#F1DDC5" Foreground="#38291E" Icon="Assets/KWTA_icon.png">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="フォルダーにまとめて保存" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="全アセット・既存GUID・.metaを保持し、配置先を変更した別の.unitypackageを作成します。" TextWrapping="Wrap" Margin="0,8,0,14"/></StackPanel>
  <StackPanel Grid.Row="1"><TextBlock Text="まとめ先フォルダー名（Assets直下）"/><TextBox x:Name="FolderName" MaxLength="255" Margin="0,6,0,8" Padding="6" TextChanged="Folder_Changed"/><TextBlock x:Name="SourceSummary" TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel>
  <StackPanel Grid.Row="2" x:Name="SpecialPanel" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock x:Name="SpecialMessage" TextWrapping="Wrap"/><CheckBox x:Name="KeepSpecial" Content="これらを元の配置に残して保存する" Margin="0,6,0,0" Checked="Folder_Changed" Unchecked="Folder_Changed"/></StackPanel>
  <TextBox Grid.Row="3" x:Name="PathExamples" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFF5E8" BorderBrush="#B59978" Padding="8"/>
  <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="固定パス参照の書き換えや、Unityプロジェクトへの取り込みは行いません。元ファイルと既存の保存先は上書きしません。" TextWrapping="Wrap"/><ProgressBar x:Name="SaveProgress" Height="6" Visibility="Collapsed" IsIndeterminate="True" Margin="0,10,0,0"/><TextBlock x:Name="ResultMessage" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button x:Name="SaveButton" Content="別名でリパッケージ保存…" Click="Save_Click" Padding="12,6" IsEnabled="False"/><Button Content="閉じる / 中止" IsCancel="True" Padding="12,6" Margin="10,0,0,0"/></StackPanel>
 </Grid>
</Window>
