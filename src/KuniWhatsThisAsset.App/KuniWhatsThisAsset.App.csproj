<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationIcon>../../IMGs/KWTA_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>embedded</DebugType>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DefineConstants Condition="'$(PublishSingleFile)' == 'true'">$(DefineConstants);KWTA_SINGLE_FILE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpAssimp" Version="6.0.12" ExcludeAssets="native" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
    <Content Include="$(NuGetPackageRoot)sharpassimp/6.0.12/runtimes/win-x64/native/assimp.dll" Link="Libs/assimp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Licenses/*.txt" />
    <Content Include="Licenses/*.txt" Link="Libs/licenses/%(Filename)%(Extension)" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="../../IMGs/KWTA_icon.png" Link="Assets/KWTA_icon.png" />
    <ProjectReference Include="../KuniWhatsThisAsset.Core/KuniWhatsThisAsset.Core.csproj" />
  </ItemGroup>
</Project>




