<Window x:Class="KuniWhatsThisAsset.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:KuniWhatsThisAsset.App" Title="KuniWhatsThisAsset v0.13.0" Icon="Assets/KWTA_icon.png" Foreground="#38291E" Width="1100" Height="900" MinWidth="700" MinHeight="500" Background="#79604A" FontFamily="Yu Gothic UI" FontSize="14" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
 <Window.Resources>
  <Style TargetType="MenuItem"><Setter Property="Background" Value="#E6C6A2"/><Setter Property="Margin" Value="1"/><Setter Property="Padding" Value="10,3"/><Setter Property="FontSize" Value="18"/></Style>
  <Style x:Key="WarningMessageText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Message}"/></Style>
 </Window.Resources>
 <DockPanel Margin="8">
  <Menu DockPanel.Dock="Top" Background="#79604A" Margin="0,0,0,10">
   <MenuItem Header="File"><MenuItem x:Name="OpenMenu" Header="ファイルを開く…" Click="Open_Click"/><MenuItem x:Name="RepackageMenu" Header="フォルダーにまとめて保存…" IsEnabled="False" Click="Repackage_Click"/><MenuItem Header="終了" Click="Exit_Click"/></MenuItem>
   <MenuItem Header="Edit"><MenuItem Header="選択した枝を一括展開" Click="Expand_Click"/><MenuItem Header="選択した枝を一括格納" Click="Collapse_Click"/></MenuItem>
   <MenuItem Header="Setting"><MenuItem Header="読み込み設定…" Click="Settings_Click"/><MenuItem Header="解析範囲について" Click="Limits_Click"/></MenuItem>
   <MenuItem Header="Help"><MenuItem Header="使い方・検出の意味" Click="Help_Click"/><MenuItem Header="ライセンス" Click="Licenses_Click"/><MenuItem Header="バージョン情報" Click="About_Click"/></MenuItem>
  </Menu>
  <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="ReloadButton" Content="⟳" FontSize="23" Padding="3,0" Margin="0,0,6,0" Click="Reload_Click" ToolTip="ファイルを再読み込み"/>
   <Button x:Name="BackButton" Grid.Column="1" Content="←" FontSize="23" Padding="3,0" Margin="0,0,6,0" IsEnabled="False" Click="Back_Click" ToolTip="前の選択"/>
   <Button x:Name="ForwardButton" Grid.Column="2" Content="→" FontSize="23" Padding="3,0" Margin="0,0,10,0" IsEnabled="False" Click="Forward_Click" ToolTip="次の選択"/>
   <Button x:Name="BookmarkButton" Grid.Column="3" Content="★" FontSize="23" Padding="3,0" Margin="0,0,8,0" Click="Bookmark_Click" PreviewMouseLeftButtonDown="Bookmark_Double" ContextMenuOpening="Bookmark_Opening"><Button.ContextMenu><ContextMenu/></Button.ContextMenu></Button>
   <TextBox x:Name="PackagePath" Grid.Column="4" IsReadOnly="True" Background="#EEDFCB" BorderThickness="0" FontSize="16" Text="File → ファイルを開く / .unitypackage・.fbx・.objをドロップ" PreviewMouseLeftButtonDown="Address_Click" ToolTip="クリックして最近開いたファイル（最大10件）を表示"/>
   <Button x:Name="CancelButton" Grid.Column="5" Content="中止" Margin="6,0,0,0" Visibility="Collapsed" Click="Cancel_Click"/>
  </Grid>
  <ProgressBar x:Name="BusyProgress" DockPanel.Dock="Top" Height="2" Visibility="Collapsed"/>
  <TextBlock Foreground="#FFF1DE" x:Name="Status" DockPanel.Dock="Bottom" Margin="2,5,0,0" FontSize="12" Text="準備完了"/>
  <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="130"/><RowDefinition Height="Auto"/><RowDefinition x:Name="WarningRow" Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="235" MinWidth="150"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
   <TreeView x:Name="PackageTree" Background="#EEDFCB" BorderThickness="0" Padding="5" SelectedItemChanged="Tree_Changed" PreviewMouseLeftButtonDown="Tree_AltClick" ToolTip="Alt＋左クリック：選択した枝以下を一括展開 / 格納" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
   <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" Background="Transparent"/>
   <Grid Grid.Column="2" Background="#EEDFCB">
    <local:ModelViewport x:Name="ModelView" Visibility="Collapsed"/>
    <Image x:Name="ImagePreview" Visibility="Collapsed" Stretch="Uniform" Margin="12" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock x:Name="PreviewHint" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#70533D" TextWrapping="Wrap" Margin="25"/>
    <TextBox x:Name="Preview" Visibility="Collapsed" IsReadOnly="True" VerticalContentAlignment="Top" FontFamily="Consolas" Background="#EEDFCB" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
   </Grid>
  </Grid>
   <GridSplitter x:Name="WarningSplitter" Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="#B59978" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"/>
   <Expander x:Name="SecurityNotice" Grid.Row="2" Visibility="Collapsed" Background="#E4CFAD" Padding="6" Expanded="Warning_Expanded" Collapsed="Warning_Collapsed">
    <Expander.Header><DockPanel><Button x:Name="DetachButton" DockPanel.Dock="Right" Content="別ウィンドウ" Click="DetachWarnings_Click" Margin="12,0,0,0" Padding="8,2"/><TextBlock x:Name="NoticeTitle" Text="要確認" VerticalAlignment="Center"/></DockPanel></Expander.Header>
    <ContentControl x:Name="WarningContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
     <Grid x:Name="WarningContent"><DataGrid x:Name="FindingsGrid" SelectionChanged="Finding_Selected"><DataGrid.Columns><DataGridTextColumn Header="重要度" Binding="{Binding Severity}" Width="85"/><DataGridTextColumn Header="種類" Binding="{Binding Code}" Width="150"/><DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource WarningMessageText}"/></DataGrid.Columns></DataGrid></Grid>
    </ContentControl>
   </Expander>
  </Grid> </DockPanel>
</Window>
